# Скопируйте в .env в корне репозитория (файл .env в .gitignore).
# После этого: python3 eidos.py chat  или  cargo run -p eidos-cli -- chat
# Профиль deepseek подхватится из config/agents.defaults.yaml автоматически.

DEEPSEEK_API_KEY=sk-your-key-here

# Альтернативное имя (тот же профиль deepseek в agents.defaults.yaml):
# LLM_API_KEY=sk-your-key-here

# Только если нужен другой профиль из agents.yaml:
# EIDOS_AGENT_PROFILE=openai_compatible_local
